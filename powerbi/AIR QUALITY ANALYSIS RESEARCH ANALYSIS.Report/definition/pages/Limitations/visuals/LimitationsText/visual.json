        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Association is not causation; emissions, traffic, humidity and transport are omitted.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "CAMS ozone is modelled reference data, not station-level observed truth.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Short seasonal windows and retrospective reanalysis do not establish year-round forecast skill.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ozone conversion assumes 25°C and 1 atm; afternoon mean is not an eight-hour maximum.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "OLS prediction bounds rely on model assumptions and omit weather/CAMS uncertainty.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "AQHI is unavailable for six additional northern communities; no proxy city is substituted.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Power BI contains an embedded dated snapshot. Refresh Python sources, rebuild this project and reopen it to update data.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Next: ECCC station validation, rolling-origin forecasts, governed ER-outcome linkage, SARIMAX and gradient boosting.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontFamily": "Segoe UI",
                      "color": "#15394B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
