              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"Location\",\"Date\",\"ActualOzone\",\"FittedOzone\",\"Temperature\",\"Wind\",\"SolarEnergy\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Location\", type text},{\"Date\", type text},{\"ActualOzone\", type number},{\"FittedOzone\", type number},{\"Temperature\", type number},{\"Wind\", type number},{\"SolarEnergy\", type number}}, \"en-US\")",
                "in",
