                "    Source = Table.FromRows(Rows, {\"Location\",\"Date\",\"ActualOzone\",\"PredictedOzone\",\"Lower95\",\"Upper95\",\"Residual\",\"RollingRMSE\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Location\", type text},{\"Date\", type text},{\"ActualOzone\", type number},{\"PredictedOzone\", type number},{\"Lower95\", type number},{\"Upper95\", type number},{\"Residual\", type number},{\"RollingRMSE\", type number}}, \"en-US\")",
                "in",
