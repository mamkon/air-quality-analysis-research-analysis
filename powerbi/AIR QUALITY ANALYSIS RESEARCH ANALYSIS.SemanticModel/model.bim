                "    Source = Table.FromRows(Rows, {\"Location\",\"Date\",\"PredictedOzone\",\"Lower95\",\"Upper95\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Location\", type text},{\"Date\", type text},{\"PredictedOzone\", type number},{\"Lower95\", type number},{\"Upper95\", type number}}, \"en-US\")",
                "in",
