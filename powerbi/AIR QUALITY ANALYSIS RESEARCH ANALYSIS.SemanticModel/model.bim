{
  "name": "AIR QUALITY ANALYSIS RESEARCH ANALYSIS",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Locations",
        "columns": [
          {
            "name": "Location",
            "dataType": "string",
            "sourceColumn": "Location",
            "summarizeBy": "none"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "Latitude",
            "dataType": "double",
            "sourceColumn": "Latitude",
            "summarizeBy": "none"
          },
          {
            "name": "Longitude",
            "dataType": "double",
            "sourceColumn": "Longitude",
            "summarizeBy": "none"
          },
          {
            "name": "TimeZone",
            "dataType": "string",
            "sourceColumn": "TimeZone",
            "summarizeBy": "none"
          },
          {
            "name": "AQHIArea",
            "dataType": "string",
            "sourceColumn": "AQHIArea",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Locations",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"Location\",\"Region\",\"Latitude\",\"Longitude\",\"TimeZone\",\"AQHIArea\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Location\", type text},{\"Region\", type text},{\"Latitude\", type number},{\"Longitude\", type number},{\"TimeZone\", type text},{\"AQHIArea\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "LocationSummary",
        "columns": [
          {
            "name": "Location",
            "dataType": "string",
            "sourceColumn": "Location",
            "summarizeBy": "none"
          },
          {
            "name": "LatestOzone",
            "dataType": "double",
            "sourceColumn": "LatestOzone",
            "summarizeBy": "none"
          },
          {
            "name": "LatestOzoneTime",
            "dataType": "string",
            "sourceColumn": "LatestOzoneTime",
            "summarizeBy": "none"
          },
          {
            "name": "ForecastOzone",
            "dataType": "double",
            "sourceColumn": "ForecastOzone",
            "summarizeBy": "none"
          },
          {
            "name": "ForecastDate",
            "dataType": "string",
            "sourceColumn": "ForecastDate",
            "summarizeBy": "none"
          },
          {
            "name": "RiskTier",
            "dataType": "string",
            "sourceColumn": "RiskTier",
            "summarizeBy": "none"
          },
          {
            "name": "AQHI",
            "dataType": "double",
            "sourceColumn": "AQHI",
            "summarizeBy": "none"
          },
          {
            "name": "AQHITime",
            "dataType": "string",
            "sourceColumn": "AQHITime",
            "summarizeBy": "none"
          },
          {
            "name": "AdjustedR2",
            "dataType": "double",
            "sourceColumn": "AdjustedR2",
            "summarizeBy": "none"
          },
          {
            "name": "R2",
            "dataType": "double",
            "sourceColumn": "R2",
            "summarizeBy": "none"
          },
          {
            "name": "HeldoutRMSE",
            "dataType": "double",
            "sourceColumn": "HeldoutRMSE",
            "summarizeBy": "none"
          },
          {
            "name": "TrainingDays",
            "dataType": "double",
            "sourceColumn": "TrainingDays",
            "summarizeBy": "none"
          },
          {
            "name": "HeldoutDays",
            "dataType": "double",
            "sourceColumn": "HeldoutDays",
            "summarizeBy": "none"
          },
          {
            "name": "TrainingStart",
            "dataType": "string",
            "sourceColumn": "TrainingStart",
            "summarizeBy": "none"
          },
          {
            "name": "TrainingEnd",
            "dataType": "string",
            "sourceColumn": "TrainingEnd",
            "summarizeBy": "none"
          },
          {
            "name": "MaxVIF",
            "dataType": "double",
            "sourceColumn": "MaxVIF",
            "summarizeBy": "none"
          },
          {
            "name": "ResidualShapiroP",
            "dataType": "double",
            "sourceColumn": "ResidualShapiroP",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "LocationSummary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"Location\",\"LatestOzone\",\"LatestOzoneTime\",\"ForecastOzone\",\"ForecastDate\",\"RiskTier\",\"AQHI\",\"AQHITime\",\"AdjustedR2\",\"R2\",\"HeldoutRMSE\",\"TrainingDays\",\"HeldoutDays\",\"TrainingStart\",\"TrainingEnd\",\"MaxVIF\",\"ResidualShapiroP\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Location\", type text},{\"LatestOzone\", type number},{\"LatestOzoneTime\", type text},{\"ForecastOzone\", type number},{\"ForecastDate\", type text},{\"RiskTier\", type text},{\"AQHI\", type number},{\"AQHITime\", type text},{\"AdjustedR2\", type number},{\"R2\", type number},{\"HeldoutRMSE\", type number},{\"TrainingDays\", type number},{\"HeldoutDays\", type number},{\"TrainingStart\", type text},{\"TrainingEnd\", type text},{\"MaxVIF\", type number},{\"ResidualShapiroP\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Selected Location",
            "expression": "SELECTEDVALUE(Locations[Location], \"Select one Ontario location\")"
          },
          {
            "name": "Snapshot Forecast Date",
            "expression": "SELECTEDVALUE(LocationSummary[ForecastDate], \"Select one location\")"
          },
          {
            "name": "Latest Ozone ppb",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(LocationSummary[LatestOzone]))",
            "formatString": "0.00"
          },
          {
            "name": "Forecast Ozone ppb",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(LocationSummary[ForecastOzone]))",
            "formatString": "0.00"
          },
          {
            "name": "Illustrative Risk Tier",
            "expression": "SELECTEDVALUE(LocationSummary[RiskTier], \"Select one location\")"
          },
          {
            "name": "Official AQHI",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(LocationSummary[AQHI]))",
            "formatString": "0.00"
          },
          {
            "name": "Model Adjusted R2",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(LocationSummary[AdjustedR2]))",
            "formatString": "0.00"
          },
          {
            "name": "Heldout RMSE ppb",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(LocationSummary[HeldoutRMSE]))",
            "formatString": "0.00"
          },
          {
            "name": "Training Days",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(LocationSummary[TrainingDays]))",
            "formatString": "0"
          },
          {
            "name": "Validation Days",
            "expression": "COUNTROWS(Validation)",
            "formatString": "0"
          },
          {
            "name": "Forecast Mean",
            "expression": "IF(HASONEVALUE(Locations[Location]), AVERAGE(Forecast[PredictedOzone]))",
            "formatString": "0.00"
          },
          {
            "name": "Forecast Lower 95",
            "expression": "IF(HASONEVALUE(Locations[Location]), AVERAGE(Forecast[Lower95]))",
            "formatString": "0.00"
          },
          {
            "name": "Forecast Upper 95",
            "expression": "IF(HASONEVALUE(Locations[Location]), AVERAGE(Forecast[Upper95]))",
            "formatString": "0.00"
          },
          {
            "name": "Reference Ozone",
            "expression": "IF(HASONEVALUE(Locations[Location]), AVERAGE(Validation[ActualOzone]))",
            "formatString": "0.00"
          },
          {
            "name": "Heldout Prediction",
            "expression": "IF(HASONEVALUE(Locations[Location]), AVERAGE(Validation[PredictedOzone]))",
            "formatString": "0.00"
          },
          {
            "name": "Rolling RMSE",
            "expression": "IF(HASONEVALUE(Locations[Location]), AVERAGE(Validation[RollingRMSE]))",
            "formatString": "0.00"
          },
          {
            "name": "Residual ppb",
            "expression": "AVERAGE(Validation[Residual])",
            "formatString": "0.00"
          },
          {
            "name": "High Cutoff ppb",
            "expression": "SELECTEDVALUE(Threshold[Value], 60)",
            "formatString": "0.00"
          },
          {
            "name": "True Positives",
            "expression": "COUNTROWS(FILTER(Validation, Validation[ActualOzone] >= [High Cutoff ppb] && Validation[PredictedOzone] >= [High Cutoff ppb]))",
            "formatString": "0"
          },
          {
            "name": "False Positives",
            "expression": "COUNTROWS(FILTER(Validation, Validation[ActualOzone] < [High Cutoff ppb] && Validation[PredictedOzone] >= [High Cutoff ppb]))",
            "formatString": "0"
          },
          {
            "name": "False Negatives",
            "expression": "COUNTROWS(FILTER(Validation, Validation[ActualOzone] >= [High Cutoff ppb] && Validation[PredictedOzone] < [High Cutoff ppb]))",
            "formatString": "0"
          },
          {
            "name": "True Negatives",
            "expression": "COUNTROWS(FILTER(Validation, Validation[ActualOzone] < [High Cutoff ppb] && Validation[PredictedOzone] < [High Cutoff ppb]))",
            "formatString": "0"
          },
          {
            "name": "Precision",
            "expression": "DIVIDE([True Positives], [True Positives] + [False Positives])",
            "formatString": "0.0%"
          },
          {
            "name": "Recall",
            "expression": "DIVIDE([True Positives], [True Positives] + [False Negatives])",
            "formatString": "0.0%"
          },
          {
            "name": "False Alarm Rate",
            "expression": "DIVIDE([False Positives], [False Positives] + [True Negatives])",
            "formatString": "0.0%"
          },
          {
            "name": "Missed Event Rate",
            "expression": "DIVIDE([False Negatives], [False Negatives] + [True Positives])",
            "formatString": "0.0%"
          },
          {
            "name": "Event Support",
            "expression": "[True Positives] + [False Negatives]",
            "formatString": "0"
          },
          {
            "name": "Confusion Count",
            "expression": "SWITCH(SELECTEDVALUE(ConfusionLabels[Outcome]), \"TP\", [True Positives], \"FP\", [False Positives], \"FN\", [False Negatives], \"TN\", [True Negatives])",
            "formatString": "0"
          },
          {
            "name": "Scenario Temp C",
            "expression": "SELECTEDVALUE(ScenarioTemperature[Value], SELECTEDVALUE(ScenarioPresets[Temperature], 26))",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Wind kmh",
            "expression": "SELECTEDVALUE(ScenarioWind[Value], SELECTEDVALUE(ScenarioPresets[Wind], 13))",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Solar Wm2",
            "expression": "SELECTEDVALUE(ScenarioSolar[Value], SELECTEDVALUE(ScenarioPresets[Solar], 230))",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Prediction ppb",
            "expression": "IF(HASONEVALUE(Locations[Location]), MAX(ModelParameters[Intercept]) + MAX(ModelParameters[TempCoef])*[Scenario Temp C] + MAX(ModelParameters[WindCoef])*[Scenario Wind kmh] + MAX(ModelParameters[SolarCoef])*[Scenario Solar Wm2]*0.0864)",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Half Width",
            "expression": "VAR t = [Scenario Temp C] VAR w = [Scenario Wind kmh] VAR s = [Scenario Solar Wm2]*0.0864 VAR h = MAX(ModelParameters[Inv00]) + 2*t*MAX(ModelParameters[Inv01]) + 2*w*MAX(ModelParameters[Inv02]) + 2*s*MAX(ModelParameters[Inv03]) + t*t*MAX(ModelParameters[Inv11]) + 2*t*w*MAX(ModelParameters[Inv12]) + 2*t*s*MAX(ModelParameters[Inv13]) + w*w*MAX(ModelParameters[Inv22]) + 2*w*s*MAX(ModelParameters[Inv23]) + s*s*MAX(ModelParameters[Inv33]) RETURN IF(HASONEVALUE(Locations[Location]), MAX(ModelParameters[TCritical])*MAX(ModelParameters[ResidualSigma])*SQRT(MAX(0,1+h)))",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Lower 95",
            "expression": "[Scenario Prediction ppb] - [Scenario Half Width]",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Upper 95",
            "expression": "[Scenario Prediction ppb] + [Scenario Half Width]",
            "formatString": "0.00"
          },
          {
            "name": "Scenario Tier",
            "expression": "VAR p = [Scenario Prediction ppb] RETURN IF(ISBLANK(p), \"Select one location\", SWITCH(TRUE(), p<0, \"Unavailable\", p<50, \"Good\", p<60, \"Moderate\", p<70, \"High\", \"Very High\"))"
          },
          {
            "name": "Scenario Extrapolation",
            "expression": "IF([Scenario Temp C]<MAX(ModelParameters[MinTemp]) || [Scenario Temp C]>MAX(ModelParameters[MaxTemp]) || [Scenario Wind kmh]<MAX(ModelParameters[MinWind]) || [Scenario Wind kmh]>MAX(ModelParameters[MaxWind]) || [Scenario Solar Wm2]*0.0864<MAX(ModelParameters[MinSolar]) || [Scenario Solar Wm2]*0.0864>MAX(ModelParameters[MaxSolar]), \"Outside training range\", \"Within marginal training ranges\")"
          },
          {
            "name": "Baseline Mean Ozone",
            "expression": "AVERAGE(Baseline[ozone])",
            "formatString": "0.00"
          },
          {
            "name": "Baseline Mean Temperature",
            "expression": "AVERAGE(Baseline[temp])",
            "formatString": "0.00"
          },
          {
            "name": "Baseline Residual",
            "expression": "AVERAGE(Baseline[Residual])",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "History",
        "columns": [
          {
            "name": "Location",
